{
  "info": {
    "name": "Legal AI - Additional Five APIs - 2026-10-16",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "신규 API 5개와 연결 흐름·실패 확인용 15개 요청. 01부터 실행합니다. 09 파일 요청은 로컬 파일 선택이 필요하며 이후 10/11에서 파일 ID를 사용합니다. 실제 Postman 실행 완료를 의미하지 않습니다. 외부 검색·LLM 호출 없음. 기존 17개 업무 요청은 BACKEND_DRAFT_TODAY Collection에 별도 보관합니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "intakeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "searchRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "visitEventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "startEventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "summaryEventId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 로그인 · 매 실행 세션/이벤트 ID 초기화",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"user\", \"password\": \"user123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"sessionId\", \"postman-\" + runId);",
              "pm.collectionVariables.set(\"visitEventId\", \"visit-\" + runId);",
              "pm.collectionVariables.set(\"startEventId\", \"start-\" + runId);",
              "pm.collectionVariables.set(\"summaryEventId\", \"summary-\" + runId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 내 정보",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"User role\", () => pm.expect(pm.response.json().role).to.eql(\"ROLE_USER\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 내 정보 · 토큰 없음 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 방문 행동 기록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intake-events",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"eventId\": \"{{visitEventId}}\", \"eventType\": \"VISIT\", \"sessionId\": \"{{sessionId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 문의 시작 행동 기록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intake-events",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"eventId\": \"{{startEventId}}\", \"eventType\": \"INTAKE_STARTED\", \"sessionId\": \"{{sessionId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 내 문의 등록 · intakeId 보관",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intakes",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"sessionId\": \"{{sessionId}}\", \"inquiryPurpose\": \"필요 자료 확인\", \"caseType\": \"CIVIL\", \"partyPosition\": \"원고\", \"coreStatement\": \"빌려준 돈을 못 받고 있습니다.\", \"desiredNextStep\": \"상담\", \"documents\": [\"입금 내역\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"intakeId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 검색 요청 기록 · searchRequestId 보관",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intakes/{{intakeId}}/search-requests",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"searchRequestId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 문의별 검색 요청 이력",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/intakes/{{intakeId}}/search-requests",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contains created request\", () => pm.expect(pm.response.json().map(x => String(x.id))).to.include(String(pm.collectionVariables.get(\"searchRequestId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 파일 업로드 · file에 sample-intake.txt 선택 필요",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/intakes/{{intakeId}}/documents",
        "auth": {
          "type": "noauth"
        },
        "description": "Body → form-data의 file 행에서 docs/fixtures/sample-intake.txt 또는 허용 파일을 선택하세요. PDF/PNG/JPEG/UTF-8 TXT, 최대 5 MiB. Content-Type을 직접 설정하지 않습니다.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            },
            {
              "key": "documentType",
              "type": "text",
              "value": "입금 내역"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"documentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 파일 다운로드 · 업로드된 documentId 사용",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/intakes/{{intakeId}}/documents/{{documentId}}/download",
        "auth": {
          "type": "noauth"
        },
        "description": "09 업로드가 성공한 후 실행합니다. 응답 저장으로 원본과 비교하세요."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Attachment\", () => pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 문의 상세 · 업로드 메타데이터 확인",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/intakes/{{intakeId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Uploaded metadata exists\", () => pm.expect(pm.response.json().uploadedDocuments.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 요약 확인 행동 기록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intake-events",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"eventId\": \"{{summaryEventId}}\", \"eventType\": \"SUMMARY_VIEWED\", \"sessionId\": \"{{sessionId}}\", \"intakeId\": {{intakeId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 동일 방문 이벤트 재전송 · 중복 저장 없음",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intake-events",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"eventId\": \"{{visitEventId}}\", \"eventType\": \"VISIT\", \"sessionId\": \"{{sessionId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Duplicate\", () => pm.expect(pm.response.json().created).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 같은 eventId에 다른 내용 · 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intake-events",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"eventId\": \"{{visitEventId}}\", \"eventType\": \"INTAKE_STARTED\", \"sessionId\": \"{{sessionId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 마케팅 집계 · 행동 이벤트 포함",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/dashboard/marketing-funnel",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Reported events\", () => pm.expect(pm.response.json().eventCounts.VISIT).to.be.above(0));",
              "pm.test(\"No invented conversion\", () => pm.expect(pm.response.json().dropOffMeasured).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}
