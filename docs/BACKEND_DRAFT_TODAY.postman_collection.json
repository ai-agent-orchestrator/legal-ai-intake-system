          "mode": "raw",
          "raw": "{\"content\":\"예시 연락처 010-1234-5678로 자료 요청\",\"followUpItems\":[\"REQUEST_DOCUMENTS\",\"SCHEDULE_CONSULTATION\"]}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Phone masked\", function () { pm.expect(pm.response.json().contentMasked).to.include(\"010-1***-****\"); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
