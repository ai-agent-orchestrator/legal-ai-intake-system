          "mode": "raw",
          "raw": "{\"sourceType\":\"PUBLIC_WEB\",\"title\":\"데모 검색 결과\",\"url\":\"https://example.com/lawyer\",\"snippet\":\"직접 전달한 예시 결과입니다.\"}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(201); });"
