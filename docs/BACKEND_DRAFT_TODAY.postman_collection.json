      ]
    },
    {
      "name": "06 검색 요청 생성 - ID 보관",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/intakes/{{intakeId}}/search-requests",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"searchRequestId\", String(body.id));",
              "pm.test(\"Preview ready\", function () { pm.expect(body.status).to.eql(\"PREVIEW_READY\"); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "07 동일 문의 검색 요청 추가 - 문의 수 중복 집계 확인용",
      "request": {
        "method": "POST",
        "header": [
          {
