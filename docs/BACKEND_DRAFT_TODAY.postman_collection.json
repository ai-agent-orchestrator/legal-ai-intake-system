          "script": {
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "11 상담 메모 - 출력 마스킹",
