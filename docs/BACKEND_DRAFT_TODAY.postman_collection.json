    {
      "name": "14 마케팅 집계 - 행동 기록 수와 측정 기준",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/dashboard/marketing-funnel"
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"Reported visit count is numeric\", function () { const visit = body.stages.find(s => s.stage === \"VISIT\"); pm.expect(visit.count).to.be.a(\"number\"); pm.expect(visit.measurement).to.eql(\"REPORTED_EVENT\"); pm.expect(body.dropOffMeasured).to.eql(false); });",
              "pm.test(\"Distinct inquiry count is no larger than request count\", function () { pm.expect(body.searchRequestedIntakeCount).to.be.at.most(body.searchRequestCount); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
