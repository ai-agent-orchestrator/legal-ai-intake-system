    {
      "name": "12-B · 선택한 Incident 상태 변경",
      "description": "C18에서 선택한 실제 id를 incidentId에 넣은 뒤 실행. riskHistoryId를 쓰지 않습니다. Body 없음.",
      "item": [
        {
          "name": "C19 PATCH 선택 Incident 확인",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/ack",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "C19 · RiskIncidentController.acknowledge()\nPath incidentId={{incidentId}}; Params 없음; Body none\nNo Auth\n200 JSON"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const selected = String(pm.variables.get('incidentId') || '');",
                  "if (!/^[1-9][0-9]*$/.test(selected)) throw new Error('C18 목록에서 실험할 id를 직접 선택하고 incidentId 변수에 넣으세요.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('same incident id', function () { pm.expect(String(pm.response.json().id)).to.eql(String(pm.variables.get('incidentId'))); });",
                  "pm.test('status ACKNOWLEDGED', function () { pm.expect(pm.response.json().status).to.eql('ACKNOWLEDGED'); });"
                ]
              }
            }
          ]
        },
