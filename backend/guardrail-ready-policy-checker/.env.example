# Template only. Spring Boot does NOT automatically load this file.
# Configure these in the backend launch environment; never put keys in VITE_*.
# Keep values empty until the actual project, model and prices are confirmed.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=
LLM_INPUT_USD_PER_1K_TOKENS=
LLM_OUTPUT_USD_PER_1K_TOKENS=
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MONTHLY_BUDGET_USD=2
LLM_DAILY_BUDGET_USD=0.50
LLM_SESSION_BUDGET_USD=0.12

# Configure and start the actual Guard service separately, including its key/model.
NEMO_GUARDRAILS_URL=http://127.0.0.1:8000
GUARDRAILS_COST_MODEL=
GUARDRAILS_INPUT_USD_PER_1K_TOKENS=
GUARDRAILS_OUTPUT_USD_PER_1K_TOKENS=

NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
SEARCH_ENABLED=true
SEARCH_MAX_RESULTS=1
